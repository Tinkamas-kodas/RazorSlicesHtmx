@inherits RazorSlice<Apskaita.Web.Features.TimeTracking.Models.TimeTrackingPageModel>
<article class="section-panel">
    <div class="tt-controls-sticky">
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div>
                <h2 class="mb-1">Time tracking</h2>
                <p class="text-muted mb-0">Weekly timeline view (30-minute slots).</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={Model.PreviousWeekStart:yyyy-MM-dd}")"
                        hx-target="#details-pane"
                        hx-swap="innerHTML"
                        hx-push-url="true">
                    Previous week
                </button>
                <button class="btn btn-outline-dark tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={DateOnly.FromDateTime(DateTime.Now):yyyy-MM-dd}")"
                        hx-target="#details-pane"
                        hx-swap="innerHTML"
                        hx-push-url="true">
                    This week
                </button>
                <button class="btn btn-outline-secondary tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={Model.NextWeekStart:yyyy-MM-dd}")"
                        hx-target="#details-pane"
                        hx-swap="innerHTML"
                        hx-push-url="true">
                    Next week
                </button>
            </div>
        </div>

        <div class="tt-week-caption">
            @Model.WeekStart.ToString("yyyy-MM-dd") - @Model.WeekEnd.ToString("yyyy-MM-dd")
        </div>
    </div>

    @await RenderPartialAsync(Apskaita.Web.Features.TimeTracking.Slices._Grid.Create(Model))
</article>
