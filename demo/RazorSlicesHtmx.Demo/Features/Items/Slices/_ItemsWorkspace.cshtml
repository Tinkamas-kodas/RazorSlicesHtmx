@inherits RazorSlice<ItemListModel>

<section id="items-workspace"
         class="section-panel"
         hx-get="@Model.Query.ToRoute("/items/list")"
         hx-trigger="Items.ListRefresh from:body"
         hx-target="this"
         hx-swap="outerHTML">
    @await RenderPartialAsync(_ItemsToolbar.Create(Model.Query))
    @await RenderPartialAsync(_ItemsListRegion.Create(Model))
</section>