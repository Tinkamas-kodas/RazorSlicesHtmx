@inherits RazorSlice<ItemUpsertRequest>
@using RazorSlicesHtmx.Demo.HtmlNames.RazorSlicesHtmx.Demo.Features.Items.Models
@using RazorSlicesHtmx.Bootstrap5.Extensions

@{ var f = Model.For(); }

<input type="hidden" name="Id" value="@Model.Id">

<div>
    @f.Code.Label("Code")
    @f.Code.Input(placeholder: "ITEM-001", autoFocus: true)
    @f.Code.Validation()
</div>

<div>
    @f.Name.Label("Name")
    @f.Name.Input(placeholder: "Item name")
    @f.Name.Validation()
</div>

<div>
    @f.IsEnabled.Checkbox()
    @f.IsEnabled.Label("Enabled")
</div>

<p class="items-modal-copy">Code must be unique. Both Code and Name are required.</p>
