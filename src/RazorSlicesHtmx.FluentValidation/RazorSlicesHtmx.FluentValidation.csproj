<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RazorSlicesHtmx.FluentValidation</RootNamespace>
    <PackageId>RazorSlicesHtmx.FluentValidation</PackageId>
    <Description>FluentValidation view contracts and helper extensions for RazorSlicesHtmx applications.</Description>
    <PackageTags>htmx;razorslices;fluentvalidation;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
