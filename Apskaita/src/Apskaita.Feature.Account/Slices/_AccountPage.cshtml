@inherits RazorSlice<Apskaita.Feature.Account.Models.AccountPageModel>

<article class="section-panel">
    <div>
        <h2 class="mb-1">Account</h2>
        <p class="text-body-secondary mb-0">Connect your own calendar accounts. Connected calendars are shown on the time tracking page.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="alert alert-@Model.NoticeKind py-2 px-3">
            @Model.Notice
            @if (!string.IsNullOrEmpty(Model.AdminConsentUrl))
            {
                <div class="mt-2">
                    <a class="btn btn-sm btn-outline-danger" href="@Model.AdminConsentUrl" target="_blank" rel="noopener noreferrer">Open admin approval page</a>
                </div>
            }
        </div>
    }

    @await RenderPartialAsync(_ConnectorsTable.Create(Model.Connectors.ToList()))
</article>
