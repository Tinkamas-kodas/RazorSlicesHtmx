@inherits RazorSlice<ItemListModel>

<article class="section-panel">
    <h2>Items</h2>
    <p class="text-muted">Sample CRUD feature with in-memory storage, search, sort, paging and modal delete.</p>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
                <form class="d-flex align-items-end gap-2"
                      hx-get="/items/list"
                      hx-include="#@ItemListQuery.StateId"
                      hx-vals='{"Page":"1"}'
                      hx-target="#feature-details"
                      hx-push-url="true">

                    <div>
                        <label class="form-label" for="items-search">Search</label>
                        <input class="form-control" id="items-search" name="Search"
                               value="@Model.Search.Search" placeholder="Search by name or description">
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark" type="submit">Apply</button>
                        <button class="btn btn-outline-secondary"
                                type="button"
                                hx-get="/items/list"
                                hx-include="#@ItemListQuery.StateId"
                                hx-vals='{"Page":"1"}'
                                hx-target="#feature-details"
                                hx-push-url="true">
                            Reset
                        </button>
                    </div>
                </form>

                <button class="btn btn-outline-dark"
                        hx-get="/items/create"
                        hx-target="#feature-details"
                        hx-push-url="true"
                        hx-params="none"
                        type="button">
                    Create new
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Search.Search))
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="text-muted">Search: @Model.Search.Search</span>
            <button class="btn btn-sm btn-outline-secondary"
                    type="button"
                    hx-get="/items/list"
                    hx-include="#@ItemListQuery.StateId"
                    hx-vals='{"Page":"1"}'
                    hx-target="#feature-details"
                    hx-push-url="true">
                Clear search
            </button>
        </div>
    }

    @await RenderPartialAsync(_ItemsList.Create(Model))
</article>
