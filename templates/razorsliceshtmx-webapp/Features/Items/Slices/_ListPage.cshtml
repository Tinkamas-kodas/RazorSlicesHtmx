@inherits RazorSlice<ItemListModel>
@using For = RshtmxApp.HtmlNames.RshtmxApp.Features.Items.Models.ItemUpsertRequestHtml
@inject IFeatureUri FeatureUri

<article class="section-panel">
    <h2>Items</h2>
    <p class="text-muted">Sample CRUD feature with in-memory storage, search, sort, paging and modal delete.</p>

    @{ var searchFor = Model.Search.For(); }
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
                <form class="d-flex align-items-end gap-2"
                        hx-get="@FeatureUri.Uri("list")"
                      hx-include="#@ItemListQuery.StateId"
                      hx-vals='{"Page":"1"}'
                      hx-target="#items-list"
                      hx-push-url="true">
                    <div>
                        <label class="form-label" for="items-search">Search</label>
                        @searchFor.Search.Input(placeholder: "Search by name or description").WithId("items-search")
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark" type="submit">Apply</button>
                        <button class="btn btn-outline-secondary"
                                type="button"
                            hx-get="@FeatureUri.Uri("list")"
                                hx-include="#@ItemListQuery.StateId"
                                hx-vals='{"Page":"1"}'
                                hx-target="#items-list"
                                hx-push-url="true">
                            Reset
                        </button>
                    </div>
                </form>

                <button class="btn btn-outline-dark"
                    hx-get="@FeatureUri.Uri("create")"
                        hx-target="#feature-details"
                        hx-push-url="true"
                        hx-params="none"
                        type="button">
                    Create new
                </button>
            </div>
        </div>
    </div>

    @await RenderPartialAsync(_ItemsList.Create(Model))
</article>
