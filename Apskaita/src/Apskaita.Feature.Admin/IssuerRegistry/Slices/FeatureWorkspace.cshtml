@inherits RazorSlice<RazorSlices.RazorSlice>
@inject HtmxStateContext StateContext

<div id="issuers-workspace" class="section-panel">
    @(StateContext.Serialize<IssuerSearchModel>(IssuerSearchModel.StateId))
    @(StateContext.Serialize<IssuerListQuery>(IssuerListQuery.StateId))

    <div id="feature-details"
         hx-get="@FeatureUri.Uri("list")"
         hx-trigger="Issuers.ListRefresh from:document"
         hx-include="#@IssuerSearchModel.StateId, #@IssuerListQuery.StateId"
         hx-push-url="true"
         hx-target="#feature-details">
        @await RenderPartialAsync(Model)
    </div>
</div>

