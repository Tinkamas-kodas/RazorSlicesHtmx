@using Apskaita.Web.Shared
@inherits RazorSlice<Apskaita.Web.Layout.Models.AppLayoutModel>
@inject IOptions<RazorSlicesHtmxOptions> HtmxOptionsAccessor

@{
    var detailTargetSelector = HtmxOptionsAccessor.Value.DetailTargetSelector;

    string ResolveIconId(AdminNavItem item)
    {
        var key = item.Key.ToLowerInvariant();
        return key switch
        {
            "time-tracking" => "nav-time-tracking",
            "clients" => "nav-clients",
            "issuers" => "nav-issuers",
            "units" => "nav-units",
            "projects" => "nav-projects",
            "invoice-templates" => "nav-invoice-templates",
            "system-settings" => "nav-system-settings",
            "users" => "nav-users",
            _ => "nav-default"
        };
    }

    var ordered = Model.Navigation.OrderBy(x => x.Order).ThenBy(x => x.Label).ToList();
    var adminItems = ordered.Where(x => string.Equals(x.Group, "ADMIN", StringComparison.OrdinalIgnoreCase)).ToList();
    var mainItems = ordered
        .Where(x => !string.Equals(x.Group, "ADMIN", StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<aside id="side-nav" class="side-nav" hx-swap-oob="@Hx.Swap.OuterHtml">
    <div class="side-nav-header">
        <a class="side-nav-brand" href="/" >
            <svg class="side-nav-logo" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 26L16 7l10 19" />
                <path d="M10.5 19h11" />
            </svg>
            
        </a>
        <button type="button" id="side-nav-toggle" class="side-nav-toggle" aria-label="Toggle sidebar" aria-expanded="true">
            <span class="side-nav-toggle-open" aria-hidden="true">&laquo;</span>
            <span class="side-nav-toggle-closed" aria-hidden="true">&raquo;</span>
        </button>
    </div>

    @if (mainItems.Count > 0)
    {
        <section class="side-nav-group side-nav-group-main">
            <h6 class="side-nav-title">Main</h6>
            <ul class="side-nav-list">
                @foreach (var item in mainItems)
                {
                    var isActive = string.Equals(Model.ActiveKey, item.Key, StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a href="@item.Route"
                           hx-get="@item.Route"
                           hx-target="@detailTargetSelector"
                           hx-swap="@Hx.Swap.InnerHtml"
                           hx-push-url="true"
                           class="side-nav-link @(isActive ? "active" : "")"
                           title="@item.Label"
                           aria-label="@item.Label">
                            <svg class="side-nav-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                <use href="/icons/sprite.svg#@ResolveIconId(item)" />
                            </svg>
                            <span class="side-nav-link-label">@item.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (adminItems.Count > 0)
    {
        <section class="side-nav-group side-nav-group-admin">
            <h6 class="side-nav-title">Admin</h6>
            <ul class="side-nav-list">
                @foreach (var item in adminItems)
                {
                    var isActive = string.Equals(Model.ActiveKey, item.Key, StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a href="@item.Route"
                           hx-get="@item.Route"
                           hx-target="@detailTargetSelector"
                           hx-swap="@Hx.Swap.InnerHtml"
                           hx-push-url="true"
                           class="side-nav-link @(isActive ? "active" : "")"
                           title="@item.Label"
                           aria-label="@item.Label">
                            <svg class="side-nav-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                <use href="/icons/sprite.svg#@ResolveIconId(item)" />
                            </svg>
                            <span class="side-nav-link-label">@item.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</aside>
