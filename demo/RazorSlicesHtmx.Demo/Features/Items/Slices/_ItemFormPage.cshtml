@inherits RazorSlice<ItemFormModel>

@{
    var isEdit = Model.Request.Id.HasValue;
    var route = isEdit ? $"/items/edit/{Model.Request.Id}" : "/items/create";
    var codeName = Model.NameFor(x => x.Request.Code);
    var codeId = Model.IdFor(x => x.Request.Code);
    var nameName = Model.NameFor(x => x.Request.Name);
    var nameId = Model.IdFor(x => x.Request.Name);
    var isEnabledName = Model.NameFor(x => x.Request.IsEnabled);
    var isEnabledId = Model.IdFor(x => x.Request.IsEnabled);
    var summary = isEdit
        ? "Update the item and return to the list with server-rendered feedback. The current list query is preserved through hidden form state."
        : "Create a new item and return to the list with server-rendered feedback. Validation runs through FluentValidation before anything is saved.";
}

<article class="section-panel">
    @await RenderPartialAsync(_SectionHero.Create(new(
        "Item editor",
        Model.Title,
        route)))

    <p class="section-summary">@summary</p>

    <div class="content-card card border-0 shadow-sm">
        <div class="card-body p-4 p-xl-5">
            <form class="d-flex flex-column gap-3"
                  hx-post="@Model.PostUrl"
                  hx-target="#details-pane"
                  hx-swap="innerHTML"
                  hx-push-url="true">
                @if (Model.Errors.Count > 0)
                {
                    <div class="alert alert-danger mb-0">Please fix the validation errors and submit again.</div>
                }

                <input type="hidden" name="Id" value="@Model.Request.Id">
                <input type="hidden" name="Search" value="@Model.Request.Search">
                <input type="hidden" name="SortBy" value="@Model.Request.SortBy">
                <input type="hidden" name="SortDir" value="@Model.Request.SortDir">
                <input type="hidden" name="Page" value="@Model.Request.Page">
                <input type="hidden" name="PageSize" value="@Model.Request.PageSize">

                <div>
                          <label class="form-label" for="@codeId">Code</label>
                    <input class="@Model.InputClass(nameof(ItemUpsertRequest.Code))"
                              id="@codeId"
                              name="@codeName"
                           value="@Model.Request.Code"
                           placeholder="ITEM-001"
                           autocomplete="off"
                           autofocus>
                          @await RenderPartialAsync(_ValidationMessage.Create(new(Model, codeName)))
                </div>

                <div>
                          <label class="form-label" for="@nameId">Name</label>
                    <input class="@Model.InputClass(nameof(ItemUpsertRequest.Name))"
                              id="@nameId"
                              name="@nameName"
                           value="@Model.Request.Name"
                           placeholder="Item name">
                          @await RenderPartialAsync(_ValidationMessage.Create(new(Model, nameName)))
                </div>

                <div class="form-check">
                    <input type="hidden" name="IsEnabled" value="false">
                          <input class="form-check-input" type="checkbox" id="@isEnabledId" name="@isEnabledName" value="true" checked="@(Model.Request.IsEnabled ? "checked" : null)">
                          <label class="form-check-label" for="@isEnabledId">Enabled</label>
                </div>

                <p class="items-modal-copy">Code must be unique. Both Code and Name are required.</p>

                <div class="d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn btn-dark">@Model.SubmitLabel</button>
                    <a class="btn btn-outline-secondary"
                       href="@Model.CancelUrl"
                       hx-get="@Model.CancelUrl"
                       hx-target="#details-pane"
                       hx-swap="innerHTML"
                       hx-push-url="true">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</article>