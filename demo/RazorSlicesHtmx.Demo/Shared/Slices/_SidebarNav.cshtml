@inherits RazorSlice<AppLayoutModel>
@inject IOptions<RazorSlicesHtmxOptions> HtmxOptionsAccessor

@{
    var detailTargetSelector = HtmxOptionsAccessor.Value.DetailTargetSelector;
}

<nav id="sidebar-nav" class="admin-sidebar" hx-swap-oob="@HtmxSwap.OuterHtml">
    <div>
        <p class="sidebar-kicker">RazorSlices</p>
        <h2 class="sidebar-title">HTMX Patterns</h2>
        <p class="sidebar-copy">A left-nav admin shell that swaps only the details pane.</p>
    </div>

    <div class="nav flex-column gap-2 mt-4">
        @foreach (var item in Model.NavigationItems)
        {
            if (item is NavigationRouteItem routeItem)
            {
                var isActive = string.Equals(Model.ActiveNavKey, routeItem.Key, StringComparison.OrdinalIgnoreCase);
                var itemClass = isActive ? "sidebar-link active" : "sidebar-link";

                <a href="@routeItem.Route"
                   hx-get="@routeItem.Route"
                   hx-target="@detailTargetSelector"
                   hx-swap="@HtmxSwap.InnerHtml"
                   hx-push-url="true"
                   class="@itemClass">
                    <span class="sidebar-link-label">@routeItem.Label</span>
                </a>
            }
            else if (item is NavigationGroupItem groupItem)
            {
                <div class="sidebar-group">
                    <span class="sidebar-group-label">@groupItem.Label</span>
                    @foreach (var child in groupItem.Children.OfType<NavigationRouteItem>())
                    {
                        var isChildActive = string.Equals(Model.ActiveNavKey, child.Key, StringComparison.OrdinalIgnoreCase);
                        var childClass = isChildActive ? "sidebar-link active" : "sidebar-link";

                        <a href="@child.Route"
                           hx-get="@child.Route"
                           hx-target="@detailTargetSelector"
                           hx-swap="@HtmxSwap.InnerHtml"
                           hx-push-url="true"
                           class="@childClass">
                            <span class="sidebar-link-label">@child.Label</span>
                        </a>
                    }
                </div>
            }
        }
    </div>
</nav>