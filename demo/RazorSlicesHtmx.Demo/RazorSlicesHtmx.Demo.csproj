<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RazorSlicesHtmx.Demo</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- RDG emits CS8639 for [FromForm] on nullable positional records; disable it since this is TrimMode=partial, not Native AOT -->
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RazorSlicesHtmx.FluentValidation\RazorSlicesHtmx.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\RazorSlicesHtmx.Bootstrap5\RazorSlicesHtmx.Bootstrap5.csproj" />
    <ProjectReference Include="..\..\src\RazorSlicesHtmx.Generators\RazorSlicesHtmx.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishTrimmed;PublishAot;PublishSingleFile;PublishReadyToRun;SelfContained" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
   
    <PackageReference Include="RazorSlices" />
  </ItemGroup>


</Project>
