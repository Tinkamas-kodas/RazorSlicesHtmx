@inherits RazorSlice<WorkActCreateDialogModel>
@using RazorSlicesHtmx.Bootstrap5.Extensions

@{ var f = Model.Request.For(); }

<div class="modal-content border-0 shadow-lg">
    @* The dialog posts to create: invalid input re-renders this dialog with inline field errors, valid
       input answers with HX-Location and the browser navigates to the review page. *@
    <form hx-post="@FeatureUri.Uri("create")" hx-target="closest .modal-content" hx-swap="outerHTML">
        <div class="modal-header">
            <h5 class="modal-title">New work act</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label" for="@f.ProjectCode.Id">Project</label>
                <select class="form-select @(Model.Request.Errors.ContainsKey(nameof(WorkActCreateRequest.ProjectCode)) ? "is-invalid" : null)"
                        id="@f.ProjectCode.Id" name="@f.ProjectCode.Name">
                    <option value="">Choose a project…</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Code" selected="@(project.Code == Model.Request.ProjectCode)">@project.Label</option>
                    }
                </select>
                @if (Model.Request.Errors.TryGetValue(nameof(WorkActCreateRequest.ProjectCode), out var codeErrors))
                {
                    <div class="invalid-feedback d-block">@codeErrors[0].errorMessage</div>
                }
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label" for="@f.DateFrom.Id">Period start</label>
                    <input class="form-control @(Model.Request.Errors.ContainsKey(nameof(WorkActCreateRequest.DateFrom)) ? "is-invalid" : null)"
                           type="date" id="@f.DateFrom.Id" name="@f.DateFrom.Name"
                           value="@Model.Request.DateFrom.ToString("yyyy-MM-dd")" />
                    @if (Model.Request.Errors.TryGetValue(nameof(WorkActCreateRequest.DateFrom), out var fromErrors))
                    {
                        <div class="invalid-feedback d-block">@fromErrors[0].errorMessage</div>
                    }
                </div>
                <div class="col-6">
                    <label class="form-label" for="@f.DateTo.Id">Period end</label>
                    <input class="form-control @(Model.Request.Errors.ContainsKey(nameof(WorkActCreateRequest.DateTo)) ? "is-invalid" : null)"
                           type="date" id="@f.DateTo.Id" name="@f.DateTo.Name"
                           value="@Model.Request.DateTo.ToString("yyyy-MM-dd")" />
                    @if (Model.Request.Errors.TryGetValue(nameof(WorkActCreateRequest.DateTo), out var toErrors))
                    {
                        <div class="invalid-feedback d-block">@toErrors[0].errorMessage</div>
                    }
                </div>
            </div>

            <div class="form-text mt-2">
                Dates are your local working days; the act stores them as UTC instants.
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-dark">Review entries</button>
        </div>
    </form>
</div>
