<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Apskaita.Web</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <UserSecretsId>6f3c1a55-9d2e-4c7b-8f1a-2d5e7b9c0a41</UserSecretsId>
    <!-- RDG cannot see BindAsync methods generated by RazorSlicesHtmx.Generators (generators don't see each other's output) -->
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql.Provider.MySql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
    <PackageReference Include="RazorSlices" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RazorSlicesHtmx.AspNetCore\RazorSlicesHtmx.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\RazorSlicesHtmx.Bootstrap5\RazorSlicesHtmx.Bootstrap5.csproj" />
    <ProjectReference Include="..\..\..\src\RazorSlicesHtmx.FluentValidation\RazorSlicesHtmx.FluentValidation.csproj" />
    <ProjectReference Include="..\..\..\src\RazorSlicesHtmx.Generators\RazorSlicesHtmx.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Apskaita.Entities\Apskaita.Entities.csproj" />
    <ProjectReference Include="..\Apskaita.Feature.Account\Apskaita.Feature.Account.csproj" />
    <ProjectReference Include="..\Apskaita.Feature.Admin\Apskaita.Feature.Admin.csproj" />
    <ProjectReference Include="..\Apskaita.Feature.TimeTracking\Apskaita.Feature.TimeTracking.csproj" />
    <ProjectReference Include="..\Apskaita.Feature.WorkActs\Apskaita.Feature.WorkActs.csproj" />
    <ProjectReference Include="..\Apskaita.Shared\Apskaita.Shared.csproj" />
  </ItemGroup>

</Project>
