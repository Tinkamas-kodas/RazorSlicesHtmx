<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RazorSlicesHtmx.FluentValidation</RootNamespace>
    <PackageId>RazorSlicesHtmx.FluentValidation</PackageId>
    <Description>Narrow FluentValidation integration for RazorSlicesHtmx that maps validation failures to server-rendered form models without bundling UI components.</Description>
    <PackageTags>htmx;razorslices;fluentvalidation;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
