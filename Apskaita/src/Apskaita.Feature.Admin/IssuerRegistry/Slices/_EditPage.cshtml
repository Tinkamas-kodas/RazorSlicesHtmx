@inherits RazorSlice<IssuerUpsertRequest>

<article class="section-panel">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <h3 class="mb-0">Edit Issuer</h3>
        @if (Model.Id.HasValue)
        {
            <div id="issuer-status-badge">
                @await RenderPartialAsync(_StatusBadge.Create(new StatusToggleModel(Model.Id.Value, Model.IsActive, string.Empty)))
            </div>
        }
    </div>
    <p class="text-muted">Update issuer profile data and return to the list.</p>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form class="d-flex flex-column gap-3"
                  hx-post
                  hx-target="#feature-details"
                  hx-push-url="false">
                @if (Model.Errors.Count > 0)
                {
                    <div class="alert alert-danger mb-0">Please fix the validation errors and submit again.</div>
                }

                @await RenderPartialAsync(_IssuerForm.Create(Model))

                <div class="d-flex flex-wrap gap-2 pt-2 align-items-center">
                    <button type="submit" class="btn btn-dark">Save changes</button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="@FeatureUri.Uri("list").HistoryBack()">
                        Cancel
                    </button>
                    @if (Model.Id.HasValue)
                    {
                        <div class="ms-auto">
                            @await RenderPartialAsync(_StatusAction.Create(new StatusToggleModel(Model.Id.Value, Model.IsActive, FeatureUri.Uri($"toggle/{Model.Id.Value}"))))
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</article>

