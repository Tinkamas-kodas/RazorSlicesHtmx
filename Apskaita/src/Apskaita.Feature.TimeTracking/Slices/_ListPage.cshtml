@inherits RazorSlice<Apskaita.Feature.TimeTracking.Models.TimeTrackingPageModel>
<article class="section-panel">
    <div class="tt-controls-sticky">
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div>
                <h2 class="mb-1">Time tracking</h2>
                <p class="text-muted mb-0">Weekly timeline view (30-minute slots).</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={Model.PreviousWeekStart:yyyy-MM-dd}")"
                        hx-target="#time-tracking-grid"
                        hx-swap="outerHTML"
                        hx-push-url="true">
                    Previous week
                </button>
                <button class="btn btn-outline-dark tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={DateOnly.FromDateTime(DateTime.Now):yyyy-MM-dd}")"
                        hx-target="#time-tracking-grid"
                        hx-swap="outerHTML"
                        hx-push-url="true">
                    This week
                </button>
                <button class="btn btn-outline-secondary tt-week-nav-btn"
                        type="button"
                        hx-get="@FeatureUri.Uri($"list?weekStart={Model.NextWeekStart:yyyy-MM-dd}")"
                        hx-target="#time-tracking-grid"
                        hx-swap="outerHTML"
                        hx-push-url="true">
                    Next week
                </button>
            </div>
        </div>

        <div class="tt-week-caption">
            @Model.WeekStart.ToString("yyyy-MM-dd") - @Model.WeekEnd.ToString("yyyy-MM-dd")
        </div>
    </div>

    @* Grid placeholder: the grid fragment arrives from `list` on load and on every refresh trigger.
       _Grid's root carries the same attributes (minus "load", which must fire once) so the outerHTML
       swap hands the refresh wiring to the incoming grid and week changes never leave a stale URL. *@
    <div id="time-tracking-grid"
         data-move-url="@FeatureUri.Uri("move")"
         hx-get="@FeatureUri.Uri($"list?weekStart={Model.WeekStart:yyyy-MM-dd}")"
         hx-trigger="load, time-tracking-list-refresh from:document"
         hx-target="this"
         hx-swap="outerHTML">
        <div class="p-3 text-muted" role="status">Loading week…</div>
    </div>
</article>
