@inherits RazorSlice<UnitUpsertRequest>
@using RazorSlicesHtmx.Bootstrap5.Extensions

@{ var f = Model.For(); }

<input type="hidden" name="Id" value="@Model.Id">

<div class="row g-3">
    <div class="col-md-4">
        <div class="form-floating">
            @f.Code.Input(placeholder: "", autoFocus: true)
            @f.Code.Label("Code")
        </div>
        @f.Code.Validation()
    </div>
    <div class="col-md-8">
        <div class="form-floating">
            @f.Name.Input(placeholder: "")
            @f.Name.Label("Name")
        </div>
        @f.Name.Validation()
    </div>
</div>


