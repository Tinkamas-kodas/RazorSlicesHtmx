@inherits RazorSlice<ItemListModel>
@using For = RshtmxApp.HtmlNames.RshtmxApp.Features.Items.Models.ItemUpsertRequestHtml

@{
    var header = Model.SortHeader("/items/list");
}

<section class="section-panel">
    <div class="mb-2">
        <p class="text-muted mb-0">
            @if (Model.Total == 0)
            {
                <text>No items found.</text>
            }
            else
            {
                <text>Showing @Model.FromItem–@Model.ToItem of @Model.Total items.</text>
            }
        </p>
    </div>

    <form class="list-request-form"
          hx-get="/items/list"
          hx-include="#@ItemSearchModel.StateId, #@ItemListQuery.StateId"
          hx-target="#feature-details"
          hx-push-url="true">
        <div class="card border-0 shadow-sm overflow-hidden">
            @if (Model.Items.Count == 0)
            {
                <div class="p-4 text-center">
                    <p class="text-muted mb-0">No items match your search. Try a different term or create the first item.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>@header.Render(For.Name.Name, "Name")</th>
                            <th>@header.Render(For.Description.Name, "Description")</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td><strong>@row.Name</strong></td>
                                <td>@row.Description</td>
                                <td>
                                    <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                                        @(row.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <button class="btn btn-sm btn-outline-secondary"
                                                hx-get="/items/edit/@row.Id"
                                                hx-target="#feature-details"
                                                hx-push-url="true"
                                                hx-params="none"
                                                type="button">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                hx-get="/items/delete/@row.Id"
                                                hx-target="#dialog-host"
                                                type="button">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-3">
            @await RenderPartialAsync(_Pager.Create(Model.ToPagerModel("/items/list")))
        </div>
    </form>
</section>
