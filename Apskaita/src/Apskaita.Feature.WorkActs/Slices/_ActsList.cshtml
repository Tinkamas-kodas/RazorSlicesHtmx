@inherits RazorSlice<WorkActListModel>

@{ var header = Model.SortHeader(FeatureUri.Uri("list")); }

<section id="work-acts-list"
         class="section-panel"
         hx-get="@FeatureUri.Uri("list")"
         hx-include="#wa-filter"
         hx-trigger="work-acts-list-refresh from:document"
         hx-target="this"
         hx-swap="outerHTML">

    <form class="list-request-form" hx-get="@FeatureUri.Uri("list")" hx-target="#work-acts-list" hx-swap="outerHTML" hx-push-url="true">
        <div id="wa-filter" class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <div class="fw-semibold small text-body-secondary mb-2">Projects</div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var project in Model.Projects)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Projects" value="@project.Id"
                                   id="wa-project-@project.Id" @(project.IsSelected ? "checked" : null) />
                            <label class="form-check-label" for="wa-project-@project.Id">@project.Label</label>
                        </div>
                    }
                </div>
                <div class="form-text">Leave all unchecked to list every project.</div>
            </div>
        </div>

        <div class="mb-2">
            <p class="text-muted mb-0">
                @if (Model.Total == 0)
                {
                    <text>No work acts found.</text>
                }
                else
                {
                    <text>Showing @Model.FromItem-@Model.ToItem of @Model.Total work acts.</text>
                }
            </p>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden">
            @if (Model.Items.Count == 0)
            {
                <div class="p-4 text-center"><p class="text-muted mb-0">No work acts match the filter.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@header.Render("projectLabel", "Project")</th>
                                <th>@header.Render("periodStart", "From")</th>
                                <th>@header.Render("periodEnd", "To")</th>
                                <th class="text-end">@header.Render("totalHours", "Hours")</th>
                                <th class="text-end">@header.Render("totalAmount", "Amount")</th>
                                <th>Status</th>
                                <th>@header.Render("createdAtUtc", "Created")</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Items)
                            {
                                <tr>
                                    <td><strong>@row.ProjectLabel</strong></td>
                                    <td>@row.PeriodStart.ToString("yyyy-MM-dd")</td>
                                    <td>@row.PeriodEnd.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">@row.TotalHours.ToString("0.##")</td>
                                    <td class="text-end">@row.TotalAmount.ToString("0.00") @row.CurrencyCode</td>
                                    <td class="small">@row.StatusLabel</td>
                                    <td>@row.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    hx-get="@FeatureUri.Uri($"detail/{row.Id}")"
                                                    hx-target="#work-acts-detail"
                                                    hx-swap="outerHTML"
                                                    hx-params="none">View</button>
                                            @if (row.IsDraft)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        hx-get="@FeatureUri.Uri($"edit/{row.Id}")"
                                                        hx-target="#work-acts-detail"
                                                        hx-swap="outerHTML"
                                                        hx-params="none">Edit</button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    hx-get="@FeatureUri.Uri($"delete/{row.Id}")"
                                                    hx-target="#dialog-host"
                                                    hx-swap="innerHTML"
                                                    hx-params="none">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-3">@await RenderPartialAsync(_Pager.Create(Model.ToPagerModel(FeatureUri.Uri("list"))))</div>
    </form>
</section>
