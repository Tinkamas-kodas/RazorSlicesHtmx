@inherits RazorSlice<ToastModel>

<div class="toast align-items-center text-bg-@Model.Tone border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
        <div class="toast-body">
            <strong class="me-2">@Model.Title</strong>
            <span>@Model.Message</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>