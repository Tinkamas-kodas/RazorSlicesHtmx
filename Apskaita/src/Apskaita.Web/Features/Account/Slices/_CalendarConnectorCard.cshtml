@inherits RazorSlice<Apskaita.Web.Features.Account.Models.CalendarConnectorCardModel>

@{
    var cardId = "connector-card-" + new string([.. Model.Key.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) || ch == '-' || ch == '_' ? ch : '-')]);
}

<div id="@cardId" class="card border-0 shadow-sm settings-connector-card" hx-swap-oob="@Hx.Swap.OuterHtml">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
            <div class="min-w-0">
                <h3 class="h6 mb-0">@Model.Label</h3>
            </div>

            @if (Model.IsImplemented)
            {
                <a class="btn btn-dark btn-sm flex-shrink-0" href="@FeatureUri.Uri($"connect/{Model.Key}")">Connect account</a>
            }
            else
            {
                <span class="badge text-bg-secondary flex-shrink-0">Coming soon</span>
            }
        </div>

        @if (Model is { IsImplemented: true, Connections.Count: 0 })
        {
            <p class="mb-0 text-muted">No accounts connected yet.</p>
        }
        else if (Model.Connections.Count > 0)
        {
            <ul class="list-group list-group-flush settings-connections">
                @foreach (var connection in Model.Connections)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3 flex-wrap px-0">
                        <div class="min-w-0">
                            <div class="fw-semibold text-truncate" title="@connection.AccountEmail">
                                @(string.IsNullOrWhiteSpace(connection.DisplayName) ? connection.AccountEmail : connection.DisplayName)
                            </div>
                            <div class="small text-muted text-truncate">@connection.AccountEmail</div>
                            @if (connection.LastSyncAtUtc is { } lastSync)
                            {
                                <div class="small text-muted">Last sync: @lastSync.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            }
                            @if (!string.IsNullOrEmpty(connection.LastSyncError))
                            {
                                <div class="small text-danger">@connection.LastSyncError</div>
                            }
                        </div>

                        @if (Model.IsImplemented)
                        {
                            <div class="flex-shrink-0 d-flex gap-2 align-items-center">
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        hx-post="@FeatureUri.Uri($"disconnect/{connection.Id}")"
                                        hx-swap="none">Disconnect</button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
