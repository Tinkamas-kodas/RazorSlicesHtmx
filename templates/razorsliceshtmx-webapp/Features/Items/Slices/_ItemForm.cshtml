@inherits RazorSlice<ItemUpsertRequest>
@using RshtmxApp.HtmlNames.RshtmxApp.Features.Items.Models
@using RazorSlicesHtmx.Bootstrap5.Extensions

@{ var f = Model.For(); }

<input type="hidden" name="Id" value="@Model.Id">

<div>
    @f.Name.Label("Name")
    @f.Name.Input(placeholder: "Item name", autoFocus: true)
    @f.Name.Validation()
</div>

<div>
    @f.Description.Label("Description")
    @f.Description.TextArea(placeholder: "Item description")
    @f.Description.Validation()
</div>

<div>
    @f.IsActive.Checkbox()
    @f.IsActive.Label("Active")
</div>
