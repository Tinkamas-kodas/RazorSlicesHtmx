@inherits RazorSlice<ItemListQuery>

<div class="content-card card border-0 shadow-sm items-toolbar-card">
    <div class="card-body p-4">
        <div class="items-toolbar">
            <form class="items-search-form"
                  hx-get="/items/list"
                hx-target="#items-workspace"
                hx-swap="outerHTML"
                hx-push-url="true">
                <div>
                    <label class="form-label" for="items-search">Search</label>
                    <input class="form-control" id="items-search" name="Search" value="@Model.Search" placeholder="Search by code or name">
                    <input type="hidden" name="SortBy" value="@Model.SortBy">
                    <input type="hidden" name="SortDir" value="@Model.SortDir">
                    <input type="hidden" name="Page" value="1">
                    <input type="hidden" name="PageSize" value="@Model.PageSize">
                </div>
                <div class="items-toolbar-actions">
                    <button class="btn btn-dark" type="submit">Apply</button>
                    @if (Model.HasSearch)
                    {
                        <a class="btn btn-outline-secondary"
                           href="@Model.ClearSearch().ToRoute("/items")"
                           hx-get="@Model.ClearSearch().ToRoute("/items/list")"
                                    hx-target="#items-workspace"
                           hx-swap="outerHTML"
                           hx-push-url="true">
                            Reset
                        </a>
                    }
                </div>
            </form>

            <button class="btn btn-outline-dark"
                    hx-get="@Model.ToRoute("/items/create")"
                    hx-target="#details-pane"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    type="button">
                Create new
            </button>
        </div>
    </div>
</div>