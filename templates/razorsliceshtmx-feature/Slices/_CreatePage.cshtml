@inherits RazorSlice<MyEntityUpsertRequest>
@using MyApp.HtmlNames.MyApp.Features.MyFeature.Models

@{ var f = Model.For(); }
@{ var fo = BootstrapFieldOptions.Floating; }

<form hx-post="/my-feature-route/create"
      hx-target="#details-pane"
      hx-swap="innerHTML"
      class="card border-0 shadow-sm p-4 d-flex flex-column gap-3">
    <h3>Create MyEntity</h3>

    <div class="form-floating">
        @f.Name.Input(placeholder: "")
        @f.Name.Label("Name", fo)
        @f.Name.Validation()
    </div>

    <div class="form-check">
        @f.IsEnabled.Checkbox()
        @f.IsEnabled.Label("Enabled")
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-dark">Save</button>
        <a hx-get="/my-feature-route/list"
           hx-target="#details-pane"
           hx-swap="innerHTML"
           class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
