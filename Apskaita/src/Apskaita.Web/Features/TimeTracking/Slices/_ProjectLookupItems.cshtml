@inherits RazorSlice<System.Collections.Generic.Dictionary<System.Guid, string?>>

@if (Model.Count == 0)
{
    <button type="button"
            class="list-group-item list-group-item-action rsh-lookup-item text-muted"
            disabled>
        No projects found
    </button>
}
else
{
    foreach (var item in Model)
    {
        <button type="button"
                class="list-group-item list-group-item-action rsh-lookup-item"
                role="option"
                data-rsh-lookup-value="@item.Key"
                data-rsh-lookup-text="@item.Value">
            @item.Value
        </button>
    }
}
