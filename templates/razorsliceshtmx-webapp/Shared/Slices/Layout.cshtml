@inherits RazorLayoutSlice<AppLayoutModel>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IOptions<RazorSlicesHtmxOptions> HtmxOptionsAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("HTTP context is required to render antiforgery tokens.");
    var antiforgeryToken = httpContext.Items["RequestVerificationToken"] as string ?? string.Empty;
    var htmxOptions = HtmxOptionsAccessor.Value;
    var detailTargetId = htmxOptions.DetailTargetSelector.TrimStart('#');
    var dialogHostId = htmxOptions.DialogHostSelector.TrimStart('#');
    var toastHostId = htmxOptions.ToastHostSelector.TrimStart('#');
    var toastDelay = htmxOptions.ToastDelayMilliseconds ?? 2600;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="htmx-config" content='{"defaultSwapStyle":"innerHTML","logAll":true}'>
    <meta name="request-verification-token" content="@antiforgeryToken">
    <title>@Model.Title</title>
    @*#if (bootstrap5)*@
    @*#if (useCdn)*@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    @*#else*@
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    @*#endif*@
    @*#endif*@
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    @(await RenderPartialAsync(_TopNav.Create(Model)))
     <div class="container" >
        <main class="pb-3">
            <section id="@detailTargetId" class="details-pane"  hx-history-elt>
                @await RenderBodyAsync()
            </section>
        </main>
    </div>

    @*#if (bootstrap5)*@
    <div id="@toastHostId" class="toast-host" aria-live="polite" aria-atomic="true"></div>
    <div id="@dialogHostId"></div>
    @*#endif*@

    @*#if (bootstrap5)*@
    @*#if (useCdn)*@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @*#else*@
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @*#endif*@
    @*#endif*@
    @*#if (useCdn)*@
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js" crossorigin="anonymous"></script>
    @*#else*@
    <script src="/lib/htmx/htmx.min.js"></script>
    @*#endif*@
    <script>
        (() => {
            const token = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content');
            if (!token) {
                return;
            }

            document.body.addEventListener('htmx:config:request', event => {
                event.detail.headers['RequestVerificationToken'] = token;
            });
        })();
    </script>
    @*#if (bootstrap5)*@
    <script>
        (() => {
            const clearModalArtifacts = () => {
                document.body.classList.remove("modal-open");
                document.body.style.removeProperty("padding-right");
                document.querySelectorAll(".modal-backdrop").forEach(b => b.remove());
            };

            const showDialogFromHost = () => {
                const host = document.getElementById("@dialogHostId");
                if (!host) return;
                const modal = host.querySelector(".modal");
                if (!modal) { clearModalArtifacts(); return; }
                clearModalArtifacts();
                modal.addEventListener("hidden.bs.modal", () => { host.innerHTML = ""; clearModalArtifacts(); }, { once: true });
                bootstrap.Modal.getOrCreateInstance(modal).show();
            };

            const showExistingToasts = () => {
                const host = document.getElementById("@toastHostId");
                if (!host) return;
                host.querySelectorAll(".toast").forEach(t => bootstrap.Toast.getOrCreateInstance(t, { delay: @toastDelay }).show());
            };

            const showToastFromTrigger = event => {
                const { title = "", message = "", tone = "info" } = event.detail ?? {};
                const host = document.getElementById("@toastHostId");
                if (!host) return;

                const bgClass = tone === "error" ? "danger" : tone;
                const el = document.createElement("div");
                el.setAttribute("role", "alert");
                el.setAttribute("aria-live", "assertive");
                el.setAttribute("aria-atomic", "true");
                el.className = `toast align-items-center text-bg-${bgClass} border-0 shadow`;

                const bodyDiv = document.createElement("div");
                bodyDiv.className = "d-flex";

                const textDiv = document.createElement("div");
                textDiv.className = "toast-body";

                const strong = document.createElement("strong");
                strong.className = "me-2";
                strong.textContent = title;

                const span = document.createElement("span");
                span.textContent = message;

                textDiv.append(strong, span);

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "btn-close btn-close-white me-2 m-auto";
                btn.setAttribute("data-bs-dismiss", "toast");
                btn.setAttribute("aria-label", "Close");

                bodyDiv.append(textDiv, btn);
                el.appendChild(bodyDiv);
                host.appendChild(el);

                bootstrap.Toast.getOrCreateInstance(el, { delay: @toastDelay }).show();
                el.addEventListener("hidden.bs.toast", () => el.remove(), { once: true });
            };

            const refresh = e => {
                const t = e?.detail?.target;
                if (!t || t.id === "@dialogHostId") showDialogFromHost();
                if (!t || t.id === "@toastHostId") showExistingToasts();
            };

            document.addEventListener("DOMContentLoaded", refresh);
            document.body.addEventListener("htmx:after:swap", refresh);
            document.body.addEventListener("htmx:after:oob-swap", refresh);
            document.addEventListener("show-dialog", showDialogFromHost);
            document.addEventListener("dialog:clear", () => {
                const host = document.getElementById("@dialogHostId");
                if (host) host.innerHTML = "";
                clearModalArtifacts();
            });
            document.addEventListener("show-toast", showToastFromTrigger);
        })();
    </script>
    @*#endif*@
</body>
</html>
