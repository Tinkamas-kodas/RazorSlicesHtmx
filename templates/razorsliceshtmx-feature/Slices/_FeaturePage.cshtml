@inherits RazorSlice<MyFeatureListModel>

<article class="section-panel">
    <h2>MyFeature</h2>

    <div id="my-feature-list" hx-trigger="MyFeature.ListRefresh from:body" hx-get="/my-feature-route/list" hx-swap="innerHTML">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@(item.IsEnabled ? "Active" : "Inactive")</td>
                        <td>
                            <a hx-get="/my-feature-route/edit/@item.Id"
                               hx-target="#details-pane"
                               hx-swap="innerHTML"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <a hx-get="/my-feature-route/create"
           hx-target="#details-pane"
           hx-swap="innerHTML"
           class="btn btn-dark">Create new</a>
    </div>
</article>
