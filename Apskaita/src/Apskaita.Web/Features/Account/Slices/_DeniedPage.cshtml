@inherits RazorSlice

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Access denied · Accounting</title>
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.8/dist/pulse/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <style>
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bs-body-bg); }
        .denied-card { width: min(480px, 92vw); }
    </style>
</head>
<body>
    <main class="denied-card card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <h1 class="h4 mb-2">Access denied</h1>
            <p class="text-muted">
                Your account does not have permission for the requested page.
                If you believe this is wrong, ask an administrator to adjust your role.
            </p>
            <a class="btn btn-outline-secondary" href="/account/login">Back to sign in</a>
        </div>
    </main>
</body>
</html>
