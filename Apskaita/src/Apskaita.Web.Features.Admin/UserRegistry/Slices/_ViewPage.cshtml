@inherits RazorSlice<UserViewModel>

<article class="section-panel">
    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <h3 class="mb-0">User Details</h3>
            <div id="user-status-badge">
                @await RenderPartialAsync(_StatusBadge.Create(new StatusToggleModel(Model.Id, Model.IsActive, string.Empty)))
            </div>
        </div>
        <button class="btn btn-outline-secondary" hx-get="@FeatureUri.Uri("list")" hx-target="#feature-details" hx-include="#@UserSearchModel.StateId, #@UserListQuery.StateId" hx-push-url="true" type="button">Back to list</button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Display name</dt>
                <dd class="col-sm-9">@Model.DisplayName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9 text-break">@Model.Email</dd>

                <dt class="col-sm-3">Provider</dt>
                <dd class="col-sm-9">@Model.Provider</dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@(Model.Role?.ToString() ?? "— (awaiting assignment)")</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Last login</dt>
                <dd class="col-sm-9">@(Model.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 pt-2 align-items-center">
        @await RenderPartialAsync(_StatusAction.Create(new StatusToggleModel(Model.Id, Model.IsActive, FeatureUri.Uri($"toggle/{Model.Id}"))))
    </div>
</article>

