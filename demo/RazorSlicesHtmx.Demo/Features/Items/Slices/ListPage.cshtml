@using RazorSlicesHtmx.Demo.HtmlNames.RazorSlicesHtmx.Demo.Features.Items.Models
@inherits RazorSlice<ItemListModel>


<article class="section-panel">
    @await RenderPartialAsync(_SectionHero.Create(new(
        "CRUD feature",
        "Items with search, sort, paging and modal editing",
        "/items")))

    <p class="section-summary">This feature uses RazorSlices for server-rendered HTML, HTMX for partial updates, and FluentValidation for create and edit validation.</p>

    @{var searchFor = Model.Search.For();}
    <div id="items-toolbar" class="content-card card border-0 shadow-sm items-toolbar-card">
        <div class="card-body p-4">
            <div class="items-toolbar">
                <form class="items-search-form"
                      hx-get="/items/list"
                      hx-include="#@ItemListQuery.StateId"
                      hx-vals='{"Page":"1"}'
                      hx-target="#items-list"
                      hx-push-url="true">
                    <div>
                    <div class="form-floating">
                        @searchFor.Search.Input(placeholder: "")
                        @searchFor.Search.Label("Search", BootstrapFieldOptions.Floating)
                    </div>
                    <div class="items-toolbar-actions">
                        <button class="btn btn-dark" type="submit">Apply</button>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                hx-get="/items/list"
                                hx-include="#@ItemListQuery.StateId"
                                hx-vals='{"Page":"1"}'
                                hx-target="#items-list"
                                hx-push-url="true">
                            Reset
                        </button>

                    </div>
                </div>
                </form>

                <button class="btn btn-outline-dark"
                        hx-get="/items/create"
                        hx-target="#feature-details"
                        hx-push-url="true"
                        hx-params="none"
                        type="button">
                    Create new
                </button>
            </div>
        </div>
    </div>

    @await RenderPartialAsync(_ItemsList.Create(Model))
</article>