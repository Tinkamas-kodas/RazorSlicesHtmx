@inherits RazorSlice<Apskaita.Web.Features.Admin.Common.Models.StatusToggleModel>

<button id="status-action-@Model.Id"
        type="button"
        class="btn btn-sm @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success")"
        hx-post="@Model.ToggleUrl"
        hx-target="#status-action-@Model.Id"
        hx-swap="outerHTML"
        hx-params="none">
    @(Model.IsActive ? "Deactivate" : "Activate")
</button>
