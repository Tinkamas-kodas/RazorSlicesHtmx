@inherits RazorSlice<IssuerListModel>
@using For = Apskaita.Feature.Admin.HtmlNames.Apskaita.Feature.Admin.IssuerRegistry.Models.IssuerUpsertRequestHtml;

@{
    var header = Model.SortHeader(FeatureUri.Uri("list"));
}

<section id="issuers-list" class="section-panel">
    <div class="mb-2">
        <p class="text-muted mb-0">
            @if (Model.Total == 0)
            {
                <text>No issuers found.</text>
            }
            else
            {
                <text>Showing @Model.FromItem-@Model.ToItem of @Model.Total issuers.</text>
            }
        </p>
    </div>

    <form class="list-request-form"
          hx-get="@FeatureUri.Uri("list")"
            hx-include:inherited="#@IssuerSearchModel.StateId, #@IssuerListQuery.StateId"
            hx-target:inherited="#issuers-list"
          hx-push-url="true">
        <div class="card border-0 shadow-sm overflow-hidden">
            @if (Model.Items.Count == 0)
            {
                <div class="p-4 text-center">
                    <p class="text-muted mb-0">No issuers match your search.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>@header.Render(For.Name.Name, "Name")</th>
                            <th>@header.Render(For.CompanyCode.Name, "Company Code")</th>
                            <th>@header.Render(For.VatCode.Name, "VAT Code")</th>
                            <th>@header.Render(For.ContactEmail.Name, "Contact Email")</th>
                            <th>@header.Render(For.IsActive.Name, "Status")</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td><strong>@row.Name</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(row.CompanyCode) ? "-" : row.CompanyCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.VatCode) ? "-" : row.VatCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.ContactEmail) ? "-" : row.ContactEmail)</td>
                                <td><span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">@(row.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" hx-get="@FeatureUri.Uri($"edit/{row.Id}")" hx-target="#feature-details" hx-push-url="true" hx-params="none" type="button">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" hx-get="@FeatureUri.Uri($"delete/{row.Id}")" hx-target="#dialog-host" type="button">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-3">
            @await RenderPartialAsync(_Pager.Create(Model.ToPagerModel(FeatureUri.Uri("list"))))
        </div>
    </form>
</section>

