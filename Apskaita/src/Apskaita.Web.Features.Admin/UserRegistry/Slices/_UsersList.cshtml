@inherits RazorSlice<UserListModel>

@{ var header = Model.SortHeader(FeatureUri.Uri("list")); }

<section id="users-list" class="section-panel">
    <div class="mb-2">
        <p class="text-muted mb-0">
            @if (Model.Total == 0)
            {
                <text>No users found.</text>
            }
            else
            {
                <text>Showing @Model.FromItem-@Model.ToItem of @Model.Total users.</text>
            }
        </p>
    </div>

    <form class="list-request-form" hx-get="@FeatureUri.Uri("list")" hx-include:inherited="#@UserSearchModel.StateId, #@UserListQuery.StateId" hx-target:inherited="#users-list" hx-push-url="true">
        <div class="card border-0 shadow-sm overflow-hidden">
            @if (Model.Items.Count == 0)
            {
                <div class="p-4 text-center"><p class="text-muted mb-0">No users match your search.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>@header.Render("DisplayName", "Name")</th>
                            <th>@header.Render("EntraObjectId", "Entra ID")</th>
                            <th>@header.Render("Email", "Email")</th>
                            <th>@header.Render("LastLoginAtUtc", "Last login")</th>
                            <th>@header.Render("IsActive", "Status")</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td><strong>@row.DisplayName</strong></td>
                                <td class="text-break">@row.EntraObjectId</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Email) ? "-" : row.Email)</td>
                                <td>@(row.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td><span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">@(row.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" hx-get="@FeatureUri.Uri($"view/{row.Id}")" hx-target="#feature-details" hx-push-url="true" hx-params="none" type="button">View</button>
                                        <button class="btn btn-sm @(row.IsActive ? "btn-outline-warning" : "btn-outline-success")" hx-post="@FeatureUri.Uri($"toggle/{row.Id}")" hx-target="#feature-details" hx-params="none" type="button">
                                            @(row.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-3">@await RenderPartialAsync(_Pager.Create(Model.ToPagerModel(FeatureUri.Uri("list"))))</div>
    </form>
</section>

