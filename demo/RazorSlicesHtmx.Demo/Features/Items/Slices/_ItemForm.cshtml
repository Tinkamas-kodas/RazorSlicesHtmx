@inherits RazorSlice<ItemUpsertRequest>

@{ var f = Model.For(); }
@{ var fo = BootstrapFieldOptions.Floating; }

<input type="hidden" name="Id" value="@Model.Id">

<div class="form-floating">
    @f.Code.Input(placeholder: "", autoFocus: true)
    @f.Code.Label("Code", fo)
    @f.Code.Validation()
</div>

<div class="form-floating">
    @f.Name.Input(placeholder: "")
    @f.Name.Label("Name", fo)
    @f.Name.Validation()
</div>

<div class="form-check">
    @f.IsEnabled.Checkbox()
    @f.IsEnabled.Label("Enabled")
</div>

<p class="items-modal-copy">Code must be unique. Both Code and Name are required.</p>
