@inherits RazorLayoutSlice<Apskaita.Web.Layout.Models.AppLayoutModel>
@using Apskaita.Web.Layout
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<RazorSlicesHtmxOptions> HtmxOptionsAccessor
@inject IWebHostEnvironment HostEnvironment
@* ReSharper disable once Html.PathError *@
@{
    var httpContext = HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("HTTP context is required to render antiforgery tokens.");
    var antiforgeryToken = httpContext.Items["RequestVerificationToken"] as string ?? string.Empty;
    var htmxOptions = HtmxOptionsAccessor.Value;
    var detailTargetId = htmxOptions.DetailTargetSelector.TrimStart('#');
    var dialogHostId = htmxOptions.DialogHostSelector.TrimStart('#');
    var toastHostId = htmxOptions.ToastHostSelector.TrimStart('#');
    var toastDelay = htmxOptions.ToastDelayMilliseconds ?? 2600;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="htmx-config" content='{"defaultSwapStyle":"innerHTML"}'>
    <meta name="request-verification-token" content="@antiforgeryToken">
    <title>@Model.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.8/dist/pulse/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    
    <link rel="stylesheet" href="/_content/RazorSlicesHtmx.Bootstrap5/css/rsh-lookup-select.css">
    <link rel="stylesheet" href="/css/site.css?v=@Assets.Version">
</head>
<body data-detail-target-id="@detailTargetId"
    data-dialog-host-id="@dialogHostId"
    data-toast-host-id="@toastHostId"
    data-toast-delay-ms="@toastDelay">
    <div class="app-shell" >
        @(await RenderPartialAsync(_SideNav.Create(Model)))
        <main class="app-main" hx-history-elt>
            <section id="@detailTargetId" class="details-pane">
                @await RenderBodyAsync()
            </section>
        </main>
    </div>

    <div id="@toastHostId" class="toast-host" aria-live="polite" aria-atomic="true"></div>
    <div id="@dialogHostId"></div>
    <div id="tt-drag-sink"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js" crossorigin="anonymous"></script>
    <script src="/_content/RazorSlicesHtmx.Bootstrap5/js/rsh-lookup-select.js"></script>
    @if (HostEnvironment.IsDevelopment())
    {
        <script src="/js/htmx-debug.js?v=20260803-1"></script>
    }
    <script src="/js/htmx-antiforgery.js?v=20260803-1"></script>
    <script src="/js/time-tracking-scroll.js?v=20260803-1"></script>
    <script src="/js/time-tracking-drag.js?v=20261009-3"></script>
    <script src="/js/app-shell-ui.js?v=20261012-1"></script>
</body>
</html>
