@inherits RazorSlice<ItemDeleteDialogModel>

<div class="modal-content border-0 shadow-lg">
    <form hx-post="@Model.PostUrl" hx-target="closest .modal-content" hx-swap="outerHTML">
        <div class="modal-header">
            <div>
                <p class="card-kicker">Delete item</p>
                <h5 class="modal-title">Remove @Model.Code?</h5>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body d-flex flex-column gap-3">
            <input type="hidden" name="Id" value="@Model.Id">
            <input type="hidden" name="Search" value="@Model.Query.Search">
            <input type="hidden" name="SortBy" value="@Model.Query.SortBy">
            <input type="hidden" name="SortDir" value="@Model.Query.SortDir">
            <input type="hidden" name="Page" value="@Model.Query.Page">
            <input type="hidden" name="PageSize" value="@Model.Query.PageSize">

            <p class="items-modal-copy">This will permanently delete <strong>@Model.Name</strong> with code <strong>@Model.Code</strong>.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Yes, delete</button>
        </div>
    </form>
</div>