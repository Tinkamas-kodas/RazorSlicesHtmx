@inherits RazorSlice<Apskaita.Feature.TimeTracking.Models.TimeTrackingModel>
@using RazorSlicesHtmx.Bootstrap5.Extensions

@{ var f = Model.For(); }

<div class="modal-content border-0 shadow-lg">
    <form hx-post="@FeatureUri.Uri("create")" hx-target="closest .modal-content" hx-swap="outerHTML">
        <div class="modal-header">
            <h5 class="modal-title">Create time entry</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        @await RenderPartialAsync(Apskaita.Feature.TimeTracking.Slices._TimeTrackingForm.Create(Model))

        @if (Model.FromCalendarEvent)
        {
            @* Calendar event reference: carried invisibly so the entry links to the event (one entry per event). *@
            <input type="hidden" name="@f.EventProviderKey.Name" value="@Model.EventProviderKey" />
            <input type="hidden" name="@f.EventAccountKey.Name" value="@Model.EventAccountKey" />
            <input type="hidden" name="@f.EventId.Name" value="@Model.EventId" />
        }

        @if (!Model.FromCalendarEvent)
        {
            <div class="px-3 pb-3">
                <div class="border-top pt-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="tt-repeat-toggle" name="Repeat" value="true" autocomplete="off" onchange="const c = document.getElementById('tt-recurrence-fields'); if (c) { c.classList.toggle('d-none', !this.checked); } const w = this.form?.querySelector('[name=\'RepeatEveryWeeks\']'); const u = this.form?.querySelector('[name=\'RepeatUntil\']'); if (w) { w.disabled = !this.checked; } if (u) { u.disabled = !this.checked; }" @(Model.Repeat ? "checked" : null)>
                    <label class="form-check-label" for="tt-repeat-toggle">Enable recurrence</label>
                </div>

                <div class="@(Model.Repeat ? null : "d-none") mt-2" id="tt-recurrence-fields">
                    <div class="d-flex flex-wrap gap-3 align-items-end">
                        <div class="flex-fill">
                            @f.RepeatEveryWeeks.Label("Repeat every (weeks)")
                            @f.RepeatEveryWeeks.Input(type: "number").WithAttribute("min", "1").WithAttribute("max", "104").WithBooleanAttribute("disabled", !Model.Repeat).WithValue((Model.RepeatEveryWeeks > 0 ? Model.RepeatEveryWeeks.Value : 1).ToString())
                        </div>
                        <div class="flex-fill">
                            @f.RepeatUntil.Label("Repeat until")
                            @f.RepeatUntil.Input(type: "date").WithBooleanAttribute("disabled", !Model.Repeat).WithValue(Model.RepeatUntil?.ToString("yyyy-MM-dd") ?? string.Empty)
                        </div>
                    </div>
                    <div class="form-text">Creates one entry per interval, from the start date up to this date.</div>
                </div>
            </div>
        </div>
        }

        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-dark">Create</button>
        </div>
    </form>
</div>

